local_head.tpl
npm-debug.log
yarn-error.log
.DS_Store

# for custom themes
css/custom/*.css
scss/custom/*.scss

#########################################################################
# This list is rather static, so let's use gitignore tricks
# Alternate approach:
# yarn install --prod --modules-folder components --ignore-optional
# but this one is more fine-grained
#########################################################################
node_modules/*

!node_modules/bootstrap
node_modules/bootstrap/*
!node_modules/bootstrap/dist
node_modules/bootstrap/dist/*
!node_modules/bootstrap/dist/js

!node_modules/bootstrap-material-design
node_modules/bootstrap-material-design/*
!node_modules/bootstrap-material-design/dist
node_modules/bootstrap-material-design/dist/*
!node_modules/bootstrap-material-design/dist/js

!node_modules/popper.js
node_modules/popper.js/*
!node_modules/popper.js/dist
node_modules/popper.js/dist/*
!node_modules/popper.js/dist/umd

!node_modules/@fortawesome
node_modules/@fortawesome/*
!node_modules/@fortawesome/fontawesome-free
node_modules/@fortawesome/fontawesome-free/*
!node_modules/@fortawesome/fontawesome-free/css
!node_modules/@fortawesome/fontawesome-free/webfonts

!node_modules/bootstrap-social
node_modules/bootstrap-social/*
!node_modules/bootstrap-social/*.css

!node_modules/photoswipe
node_modules/photoswipe/*
!node_modules/photoswipe/dist

!node_modules/slick-carousel
node_modules/slick-carousel/*
!node_modules/slick-carousel/slick

!node_modules/selectize
node_modules/selectize/*
!node_modules/selectize/dist

!node_modules/jQuery-Touch-Events
node_modules/jQuery-Touch-Events/*
!node_modules/jQuery-Touch-Events/src
node_modules/jQuery-Touch-Events/src/*
!node_modules/jQuery-Touch-Events/src/*.min.js

!node_modules/wordcloud
node_modules/wordcloud/*
!node_modules/wordcloud/LICENSE
!node_modules/wordcloud/src

#########################################################################
# REDUX — ajouts propres au fork, en fin de fichier : placés APRÈS les
# négations ci-dessus, ils l'emportent sur elles (la dernière règle gagne).
#
# ⛔ NE PAS y transposer les motifs habituels de la flotte
# (`*.css`, `*.min.css`, `*.min.js`) : ici ils seraient DESTRUCTEURS. Le thème
# versionne ses CSS compilés (theme.css, css/**/bootstrap.css) et une sélection
# de `.min.js` sous node_modules/, via les négations ci-dessus — aucune étape
# de build ne les régénère à la livraison. Les ignorer déréférencerait des
# centaines de fichiers dont le thème a besoin à l'exécution.
#########################################################################

# Source maps : inutiles à l'exécution (le navigateur ne les demande qu'avec
# les DevTools ouvertes) et ~60 Mo à elles seules. Retirées du dépôt ;
# tools/vendor.py n'en conserve jamais, et ce motif couvre aussi celles que
# ramènerait une installation manuelle sous node_modules/.
*.map

# IDE & outils locaux
.vscode/
.idea/
.playwright-mcp/
__pycache__/
*.py[cod]
Thumbs.db

# Secrets and local config.
# .env* is ignored, EXCEPT the project manifest (non-secret build settings), tracked
# as everywhere else in the fleet so that a fresh clone can build (piwigo_local#1274).
.env*
!.local/scripts/.env.project

# Agent instructions: private tooling, kept out of the public repository.
CLAUDE.md

# Superpowers + worktrees (artefacts éphémères, non versionnés)
.superpowers/
.worktrees/

# Staging de build devtools (manifeste, sidecars, archives)
/.build/

# Artefact de php-cs-fixer
.php-cs-fixer.cache

# Artefact d'audit i18n (dry-run devtools — régénéré à la demande)
.local/AUDIT-i18n.md

# Shared jm-* commons, injected from the toolkit at build time (#17): never tracked.
**/jm-*

# Admin assets compiled by `npm run minify` (#17): built, not tracked.
admin/assets/css/*.css
admin/assets/js/*.min.js

# Dossier d'images sources (avant conversion WebP) — exclu de tout le parc.
.local/archives/
