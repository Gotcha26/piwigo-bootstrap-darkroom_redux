local_head.tpl
npm-debug.log
yarn-error.log
.DS_Store

# for custom themes
css/custom/*.css
scss/custom/*.scss

#########################################################################
# This list is rather static, so let's use gitignore tricks
# Alternate approach:
# yarn install --prod --modules-folder components --ignore-optional
# but this one is more fine-grained
#########################################################################
node_modules/*

!node_modules/bootstrap
node_modules/bootstrap/*
!node_modules/bootstrap/dist
node_modules/bootstrap/dist/*
!node_modules/bootstrap/dist/js

!node_modules/bootstrap-material-design
node_modules/bootstrap-material-design/*
!node_modules/bootstrap-material-design/dist
node_modules/bootstrap-material-design/dist/*
!node_modules/bootstrap-material-design/dist/js

!node_modules/jquery
node_modules/jquery/*
!node_modules/jquery/dist

!node_modules/jquery-migrate
node_modules/jquery-migrate/*
!node_modules/jquery-migrate/dist

!node_modules/popper.js
node_modules/popper.js/*
!node_modules/popper.js/dist
node_modules/popper.js/dist/*
!node_modules/popper.js/dist/umd

!node_modules/@fortawesome
node_modules/@fortawesome/*
!node_modules/@fortawesome/fontawesome-free
node_modules/@fortawesome/fontawesome-free/*
!node_modules/@fortawesome/fontawesome-free/css
!node_modules/@fortawesome/fontawesome-free/webfonts

!node_modules/bootstrap-social
node_modules/bootstrap-social/*
!node_modules/bootstrap-social/*.css

!node_modules/photoswipe
node_modules/photoswipe/*
!node_modules/photoswipe/dist

!node_modules/slick-carousel
node_modules/slick-carousel/*
!node_modules/slick-carousel/slick

!node_modules/selectize
node_modules/selectize/*
!node_modules/selectize/dist

!node_modules/typeface-pt-sans
!node_modules/typeface-roboto

!node_modules/jQuery-Touch-Events
node_modules/jQuery-Touch-Events/*
!node_modules/jQuery-Touch-Events/src
node_modules/jQuery-Touch-Events/src/*
!node_modules/jQuery-Touch-Events/src/*.min.js

#########################################################################
# REDUX — outillage local, ajouté au fork. Bloc volontairement ADDITIF et
# placé en fin de fichier : tout ce qui précède appartient à l'amont, et le
# garder intact garde `git merge upstream/master` trivial sur ce fichier.
#
# ⛔ NE PAS y transposer les motifs habituels de la flotte
# (`*.css`, `*.min.css`, `*.min.js`) : ici ils seraient DESTRUCTEURS. L'amont
# versionne délibérément ses CSS compilés (theme.css, css/**/bootstrap.css) et
# une sélection de `.min.js` sous node_modules/, via les négations ci-dessus.
# Les ignorer déréférencerait des centaines de fichiers suivis par l'amont.
#########################################################################

# IDE & outils locaux
.vscode/
.idea/
__pycache__/
*.py[cod]
Thumbs.db

# Secrets et config locale.
.env*

# Outillage local (devtools) : NON versionné sur ce dépôt.
# Écart assumé à la convention de la flotte, qui suit `.local/scripts/.env.project`
# comme manifeste de build. Ce dépôt est un fork PUBLIC de projet tiers : le
# manifeste y porterait les chemins absolus du poste (PROJECT_ROOT, EasyPHP) et du
# bruit d'outillage privé sous les yeux de l'amont. Il vit sur le disque, et le
# registre de flotte .env.plugins l'y trouve.
.local/

# Superpowers + worktrees (artefacts éphémères, non versionnés)
.superpowers/
.worktrees/

# Staging de build devtools (manifeste, sidecars, archives)
/.build/

# Artefact de php-cs-fixer
.php-cs-fixer.cache

# Artefact d'audit i18n (dry-run devtools — régénéré à la demande)
.local/AUDIT-i18n.md
