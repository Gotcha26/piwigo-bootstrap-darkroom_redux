# ============================================================
# CONFIG PROJET BOOTSTRAP DARKROOM (REDUX) — DELTAS thème uniquement
# ============================================================
#
# Redux est un THÈME, FORK AUTONOME (depuis le 2026-10-18) d'un dépôt tiers
# (Piwigo/piwigo-bootstrap-darkroom). L'amont n'est plus qu'une source de
# reports sélectifs : rester fusionnable n'est plus un objectif.
#
# Aucun secret ici. Machine + credentials vivent dans le canonique
# Piwigo/.local/scripts/ (.env.machine, .env.secrets) — jamais recopiés.
#
# Une variable laissée VIDE = défaut code appliqué (le loader ignore les vides).
#
# Statut git : versionné, comme dans toute la flotte (override `!` du .gitignore).
# ============================================================

# --- Identité ---
PROJECT_TYPE=theme

# 🔴 NE PAS METTRE « redux » ICI. schema.py:189 fait
#   project_name = env.get("PROJECT_NAME", Path(project_root).name)
# et le chemin de déploiement est dérivé en themes/<project_name>. Le fork est
# un REMPLACEMENT DROP-IN de l'amont : il doit occuper themes/bootstrap_darkroom,
# faute de quoi (a) BCBG, qui déclare `'parent' => 'bootstrap_darkroom'`, perd son
# parent, et (b) la détection `strpos($theme, 'bootstrap_darkroom')` du module
# skyline de centralAdmin ne reconnaît plus rien.
# Sans cette ligne, le défaut serait le nom du dossier de travail
# (« bootstrap-darkroom_redux ») et le deploy irait au mauvais endroit.
PROJECT_NAME=bootstrap_darkroom
LOGO_SLUG=bootstrapDarkroom
PROJECT_ROOT=D:\Gotcha\Documents\DIY\GitHub\Piwigo\bootstrap-darkroom_redux
FREE_REPO_URL=https://github.com/Gotcha26/piwigo-bootstrap-darkroom_redux.git

# --- Licence : Apache 2.0, héritée de l'amont (piwigo_local#1216) ---
# Pas de LICENCE.md GPL injecté ; LICENSE.txt (tracké, dans BUILD_ZONES) est
# livré tel quel et le build échoue s'il manque. COPYING.md cite l'amont.
PROJECT_LICENSE=apache-2.0
PROJECT_LICENSE_FILE=LICENSE.txt
UPSTREAM_NAME=Bootstrap Darkroom
UPSTREAM_COPYRIGHT=Thomas Kuther
UPSTREAM_URL=https://github.com/Piwigo/piwigo-bootstrap-darkroom

# --- Déploiement ---
# Support natif du type `theme` : le toolkit dérive themes/<PROJECT_NAME>
# (local + remote) à partir de PROJECT_TYPE=theme. REMOTE_DIR reste vide →
# hérite du défaut workspace (racine Piwigo, cf. .env.secrets canonique).
#
# Le deploy SSH vers o2switch est le SEUL canal réellement utilisé pour ce
# projet : c'est ainsi qu'on éprouve un correctif sur la galerie avant de le
# proposer en PR amont. Cf. la section « Release ZIP » plus bas.
DEPLOY_SRC=
DEPLOY_DST=
REMOTE_DIR=

# --- Manifeste de build & zonage Free/Pro ---
# Redux est GRATUIT ET NON COMMERCIALISÉ : pas de licence, pas de zone -pro, pas
# de stub, pas de slug catalogue. Sa distribution EST le dépôt GitHub public.
#
# BUILD_PRO_SUFFIX reste néanmoins OBLIGATOIRE : la variable est fail-loud parce
# qu'un suffixe vide rendrait str.endswith("") vrai pour tout, ce qui classerait
# l'intégralité du thème en Pro et sortirait un ZIP Free vide. Aucun fichier ne
# porte ce suffixe ici, donc tout tombe en Free — comportement voulu.
BUILD_PRO_SUFFIX=-pro

# node_modules/ est VOLONTAIREMENT dans les zones : l'amont y versionne, par un
# jeu de négations dans son .gitignore, les dist de bootstrap, jquery, photoswipe,
# slick, fontawesome… que le thème charge à l'exécution. Un ZIP qui l'omettrait
# livrerait un thème sans JS ni webfonts.
# Piège : l'omission d'un fichier racine NON-PHP de BUILD_ZONES est SILENCIEUSE
# (la garde fail-loud de build_common.py:314 ne couvre que les .php).
# custom-derivatives.json : constaté sur le premier build qui l'a porté
# (centralAdmin#704) — ZIP complet, sauf lui. Sans ce manifeste, Cache
# Machine ne propose aucune dérivée du thème, BC-BG compris (il en hérite).
# LICENSE.txt : même piège, constaté le 2026-10-18 — il manquait à tous les ZIP.
# Le thème est sous Apache 2.0, qui EXIGE d'en livrer une copie (cf. PROJECT_LICENSE).
BUILD_ZONES=themeconf.inc.php,theme.css,screenshot.png,LICENSE.txt,index.php,custom-derivatives.json,admin,assets,css,img,include,js,language,template,node_modules

# Les SOURCES scss ne partent pas : le CSS est figé (plus de chaîne de compilation, cf.
# CLAUDE.md), pas minifié par minify.js. Cf. MINIFY_ASSETS_ROOTS plus bas.
# *.map : les source maps ont été retirées du dépôt (et des commentaires
# sourceMappingURL) ; ce motif garde le ZIP propre si une map locale traîne.
BUILD_EXCLUDE_PATTERNS=*.scss,*.map

# Release ZIP est le SEUL canal qui livre les communs injectés et les .min.js de
# l'admin : il doit construire proprement. Tout le PHP est en 2 espaces + K&R.

# --- Injection des communs (modèle G) : panneau d'admin uniquement ---
# Décision de Gotcha26/piwigo-bootstrap-darkroom_redux#17 : le panneau d'admin est
# monté sur le socle jm-* commun. Les gabarits publics n'en consomment aucun.
# Liste = ce que admin/admin.inc.php charge réellement, dépendances de jm-vendor
# comprises (jm-http, jm-cert, jm-download-hardened, jm-constants).
# BC-BG injecte ses propres copies : jm-boot élit la plus fraîche, les gardes
# function_exists font le reste.
INJECT_PHP_COMMONS=jm-access.php,jm-boot.php,jm-constants.php,jm-http.php,jm-cert.php,jm-download-hardened.php,jm-vendor-pins.php,jm-vendor.php,jm-vendor.lang.php,jm-ws.php,jm-asset.php,jm-theme-detector.php,jm-help-support.php,jm-help-support.lang.php,jm-help.lang.php,jm-credits.php,jm-credits.lang.php,jm-maintenance.php,jm-maintenance.lang.php,jm-export-import.php,jm-export-import.lang.php,jm-icons.php
INJECT_PHP_COMMONS_DIR=include
INJECT_TPL_COMMONS=jm-admin-shell.tpl,jm-header.tpl,jm-tabs-nav.tpl,jm-section-header.tpl,jm-savebar.tpl,jm-help-support.tpl,jm-credits-modal.tpl,jm-credits-content.tpl,jm-modal.tpl,jm-fonts.tpl,jm-help-wip.tpl,jm-maintenance.tpl,jm-brick-accordion-mode.tpl,jm-brick-export-import.tpl,jm-choice-grid.tpl,jm-vendor-alert.tpl
INJECT_TPL_COMMONS_DIR=admin/template
INJECT_JS_COMMONS=

# --- Minification assets : admin seulement ---
# Le CSS public est figé (Bootstrap 4.3.1, chaîne node-sass retirée) et livré tel
# quel. Seuls les actifs du panneau d'admin passent par minify.js (script `minify`
# du package.json, BUILD-MANIFEST règle 12). Les jm-*.js sont auto-inclus.
# ⛔ Ne pas poser BUILD_EXCLUDE_NON_MIN=true : la garde inspecterait tout scss/.
MINIFY_ASSETS_ROOTS=admin/assets/css,admin/assets/js
MINIFY_SCSS_LOAD_PATHS=../.local/assets/css

# --- OPcache ---
# Renseigné dès le départ : ce projet a vocation à être redéployé souvent pour
# éprouver un correctif sur la galerie. Sans cela, OPcache sert l'ANCIEN bytecode
# après un deploy à chaud et on croit tester un correctif qu'on ne teste pas.
OPCACHE_TOUCH_FILES=themeconf.inc.php,admin/admin.inc.php,include/*.php
